# MongoDB connection string (from Atlas: Database > Connect > Drivers)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority

# Which database inside the cluster holds the grading data
MONGO_DB_NAME=studentportal

# Set to "true" while MongoDB schema/collections are still being confirmed.
# The API will serve mock data instead of querying MongoDB.
USE_MOCK_DATA=true

# Comma-separated list of origins allowed to call this API (your React dev server)
CORS_ORIGINS=http://localhost:5173